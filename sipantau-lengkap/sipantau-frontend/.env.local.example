# ──────────────────────────────────────────────────────────────────────────
#  SiPantau Frontend — Konfigurasi Environment
#  Salin file ini ke .env.local lalu sesuaikan nilai-nilainya:
#    cp .env.local.example .env.local
# ──────────────────────────────────────────────────────────────────────────

# URL backend Python (main.py) — ubah sesuai IP/port server kamu
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL local agent untuk scraping
NEXT_PUBLIC_AGENT_URL=http://localhost:7777
