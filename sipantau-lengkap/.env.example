# ─── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5050
DB_NAME=sipantau
DB_USER=postgres
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB_ANDA

# ─── Admin Default ─────────────────────────────────────────────────
# Password admin saat pertama kali DB dibuat. Jika dikosongkan, sistem
# akan generate password acak dan mencetaknya sekali di log startup.
# Hapus atau kosongkan baris ini setelah admin pertama berhasil login.
ADMIN_DEFAULT_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_AWAL

# ─── JWT ───────────────────────────────────────────────────
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK_YANG_PANJANG
JWT_EXPIRE_HOURS=12

# ─── CORS ──────────────────────────────────────────────────
# Pisahkan dengan koma jika lebih dari satu origin
ALLOWED_ORIGINS=http://localhost:3000
